# Copy this file to .env and fill in your DagsHub credentials.
# DO NOT commit .env to Git.

# DagsHub repository: https://dagshub.com/<username>/<repo>
DAGSHUB_REPO_OWNER=your_dagshub_username
DAGSHUB_REPO_NAME=your_dagshub_repo_name

# DagsHub token from https://dagshub.com/user/settings/tokens
DAGSHUB_TOKEN=your_dagshub_token

# MLflow tracking server (DagsHub)
# Replace <owner> and <repo_name> with your values.
MLFLOW_TRACKING_URI=https://dagshub.com/<owner>/<repo_name>.mlflow
MLFLOW_TRACKING_USERNAME=your_dagshub_username
MLFLOW_TRACKING_PASSWORD=your_dagshub_token
